{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "a-oic/ai-plan.schema.json",
  "title": "AIResponsePlan",
  "type": "object",
  "required": ["schema_version", "summary", "actions"],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["1.0"]
    },
    "summary": {
      "type": "string",
      "minLength": 20
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["type", "target"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["scale", "rollback", "restart", "verify"]
          },
          "target": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
